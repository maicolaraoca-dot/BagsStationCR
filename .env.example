# ══════════════════════════════════════════════════════════════════════════════
# Bags Station CR — Variables de entorno requeridas
# Copia este archivo a .env.local y completa los valores.
# NUNCA commitees .env.local ni ningún archivo con valores reales.
# ══════════════════════════════════════════════════════════════════════════════

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Base de datos (ejemplo: Supabase / PlanetScale / Neon) ──────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DIRECT_URL=postgresql://user:password@host:5432/dbname

# ─── Supabase (si se usa) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...      ← segura en frontend (row-level security)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...          ← SOLO en servidor, NUNCA en cliente

# ─── Autenticación (si se implementa) ────────────────────────────────────────
# NEXTAUTH_SECRET=genera-con: openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3000

# ─── Pagos (ejemplo: Stripe) ─────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...             ← SOLO en servidor
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...  ← segura en frontend
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (ejemplo: Resend / SendGrid) ──────────────────────────────────────
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@bagsstationcr.com

# ─── WhatsApp Business API (si se migra de links directos) ───────────────────
# WHATSAPP_TOKEN=...
# WHATSAPP_PHONE_ID=...
